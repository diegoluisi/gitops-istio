{
  "uid": "istio-workloads",
  "title": "Istio Workloads Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "istio",
    "sidecar",
    "mimir",
    "gitops"
  ],
  "description": "Metrics collected from Istio sidecars and gateways by Alloy and stored in Mimir. Reporter series identify each observation point.",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Application namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(istio_requests_total, destination_workload_namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "workload",
        "label": "Workloads",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(istio_requests_total, destination_workload)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (destination_workload, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval]))",
          "legendFormat": "{{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx percentage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (destination_workload, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\",response_code=~\"5..\"}[$__rate_interval])) / sum by (destination_workload, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval]))",
          "legendFormat": "{{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, destination_workload, reporter) (rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval])))",
          "legendFormat": "{{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
