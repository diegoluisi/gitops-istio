{
  "uid": "istio-control-plane",
  "title": "Istio Control Plane and Gateways",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "istio",
    "gitops"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Istiod scrape availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"integrations/istio\",namespace=\"istio-system\"}",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Connected proxies",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pilot_xds",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Configuration push rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(pilot_xds_pushes[$__rate_interval]))",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Configuration rejects",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(pilot_total_xds_rejects[$__rate_interval]))",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Event metric may be absent until the first event, or unsupported by this Istio version. No data is not proof of zero failures; check scrape availability and Istiod logs."
    },
    {
      "id": 5,
      "title": "Configuration push p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(pilot_xds_push_time_bucket[$__rate_interval])))",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Istiod CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"istio-system\",container=\"discovery\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Gateway request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, pod, reporter) (rate(istio_requests_total{namespace=\"istio-gateways\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}} {{pod}} {{reporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Reports source and destination observations separately to avoid combining both sides of a request."
    },
    {
      "id": 8,
      "title": "Gateway 5xx rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, pod, reporter) (rate(istio_requests_total{namespace=\"istio-gateways\",response_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}} {{pod}} {{reporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Reports source and destination observations separately to avoid combining both sides of a request."
    },
    {
      "id": 9,
      "title": "Gateway memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"istio-gateways\",container=\"istio-proxy\"})",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Gateway proxy CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"istio-gateways\",container=\"istio-proxy\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "mTLS HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (destination_service_name) (rate(istio_requests_total{reporter=\"destination\",connection_security_policy=\"mutual_tls\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Certificate issuance errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(citadel_server_csr_sign_err_count[$__rate_interval]))",
          "legendFormat": "{{namespace}} {{pod}} {{deployment}} {{node}} {{type}} {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Event metric may be absent until the first event, or unsupported by this Istio version. No data is not proof of zero failures; check scrape availability and Istiod logs."
    }
  ],
  "links": [
    {
      "title": "Istio dashboards",
      "type": "dashboards",
      "tags": [
        "istio"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ]
}
