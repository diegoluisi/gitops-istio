{
  "uid": "istio-ambient-overview",
  "title": "Istio Sidecar Metrics",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "istio",
    "sidecar",
    "mimir",
    "gitops"
  ],
  "description": "Metrics collected from Istio sidecars and gateways by Alloy and stored in Mimir. Reporter series identify each observation point.",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Application namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(istio_requests_total, destination_workload_namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "scrape_namespace",
        "label": "Scrape namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(up{job=\"integrations/istio\"}, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, destination_service_name, reporter) (workload:istio_requests_total:rate5m{destination_workload_namespace=~\"$namespace\"})",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Uses Mimir workload recording rules with a fixed 5-minute rate window. Source and destination reporters remain separate."
    },
    {
      "id": 2,
      "title": "HTTP 5xx percentage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum by (cluster, destination_service_name, reporter) (workload:istio_requests_total:rate5m{destination_workload_namespace=~\"$namespace\",response_code=~\"5..\"})) or (0 * (sum by (cluster, destination_service_name, reporter) (workload:istio_requests_total:rate5m{destination_workload_namespace=~\"$namespace\"})))) / (sum by (cluster, destination_service_name, reporter) (workload:istio_requests_total:rate5m{destination_workload_namespace=~\"$namespace\"}))",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Zero when requests are observed without HTTP 5xx responses; undefined when request rate is zero. Source and destination reporters are kept separate."
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (cluster, le, destination_service_name, reporter) (workload:istio_request_duration_milliseconds_bucket:rate5m{destination_workload_namespace=~\"$namespace\"}))",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Uses Mimir workload recording rules with a fixed 5-minute rate window. Source and destination reporters remain separate."
    },
    {
      "id": 4,
      "title": "TCP bytes sent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, source_workload, destination_workload, reporter) (workload:istio_tcp_sent_bytes_total:rate5m{source_workload_namespace=~\"$namespace\"})",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Uses Mimir workload recording rules with a fixed 5-minute rate window. Source and destination reporters remain separate."
    },
    {
      "id": 5,
      "title": "TCP connections opened",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, source_workload, destination_workload, reporter) (workload:istio_tcp_connections_opened_total:rate5m{source_workload_namespace=~\"$namespace\"})",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Uses Mimir workload recording rules with a fixed 5-minute rate window. Source and destination reporters remain separate."
    },
    {
      "id": 6,
      "title": "Istio scrape target health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"integrations/istio\",namespace=~\"$scrape_namespace\"}",
          "legendFormat": "{{namespace}} / {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "links": [
    {
      "title": "Istio dashboards",
      "type": "dashboards",
      "tags": [
        "istio"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ]
}
