{
  "uid": "istio-ambient-overview",
  "title": "Istio Sidecar Metrics",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "istio",
    "sidecar",
    "mimir",
    "gitops"
  ],
  "description": "Metrics collected from Istio sidecars and gateways by Alloy and stored in Mimir. Reporter series identify each observation point.",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Application namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(istio_tcp_sent_bytes_total, source_workload_namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (destination_service_name, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}}) {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx percentage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (destination_service_name, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\",response_code=~\"5..\"}[$__rate_interval])) / sum by (destination_service_name, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}}) {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, destination_service_name, reporter) (rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}}) {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "TCP bytes sent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source_workload, destination_workload, reporter) (rate(istio_tcp_sent_bytes_total{source_workload_namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}}) {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "TCP connections opened",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source_workload, destination_workload, reporter) (rate(istio_tcp_connections_opened_total{source_workload_namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}}) {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Istio scrape target health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"istio\"}",
          "legendFormat": "{{destination_service_name}} {{source_workload}} \u2192 {{destination_workload}} ({{reporter}}) {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
