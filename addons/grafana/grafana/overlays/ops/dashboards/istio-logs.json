{
  "uid": "istio-logs",
  "title": "Istio Logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "istio",
    "loki",
    "gitops"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "query": "bookinfo,bookstore,istio-system,istio-gateways,alloy,tempo,mimir,grafana,loki,kiali-system",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Application and mesh logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{cluster=\"ops\",namespace=~\"${namespace:regex}\"} |= ${search:doublequote}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
