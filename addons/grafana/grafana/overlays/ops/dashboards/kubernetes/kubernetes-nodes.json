{
  "uid": "kubernetes-nodes",
  "title": "Kubernetes Nodes",
  "description": "Node-exporter collects the Linux Kubernetes node VM, not the macOS host. Host mounts/host networking are required by the exporter. Some filesystem or device metrics depend on Docker Desktop support.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "kubernetes",
    "gitops"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by(node)(rate(node_cpu_seconds_total{job=\"kubernetes-node-exporter\",mode=\"idle\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1-node_memory_MemAvailable_bytes{job=\"kubernetes-node-exporter\"}/node_memory_MemTotal_bytes{job=\"kubernetes-node-exporter\"}",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Load / CPU count",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{job=\"kubernetes-node-exporter\"}/on(node) group_left count by(node)(node_cpu_seconds_total{job=\"kubernetes-node-exporter\",mode=\"idle\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Filesystem utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1-node_filesystem_avail_bytes{job=\"kubernetes-node-exporter\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*|/var/lib/kubelet/pods/.*\"}/node_filesystem_size_bytes{job=\"kubernetes-node-exporter\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*|/var/lib/kubelet/pods/.*\"}",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Disk reads",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{job=\"kubernetes-node-exporter\",device!~\"loop.*\"}[5m])",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Disk writes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_written_bytes_total{job=\"kubernetes-node-exporter\",device!~\"loop.*\"}[5m])",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Network received",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{job=\"kubernetes-node-exporter\",device!=\"lo\"}[5m])",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Network sent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_bytes_total{job=\"kubernetes-node-exporter\",device!=\"lo\"}[5m])",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Node pressure",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_node_status_condition{condition=~\"MemoryPressure|DiskPressure|PIDPressure\",status=\"true\"}",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    }
  ]
}
