{
  "uid": "kubernetes-control-plane",
  "title": "Kubernetes API & DNS",
  "description": "Authenticated API-server metrics plus per-pod DNS scrapes through the Kubernetes pod proxy. Scheduler/controller-manager/etcd endpoints are not exposed in this lab.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "kubernetes",
    "gitops"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(verb,code)(rate(apiserver_request_total{job=\"kubernetes-apiserver\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "API 5xx rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(code)(rate(apiserver_request_total{job=\"kubernetes-apiserver\",code=~\"5..\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "API request p95 (non-watch)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,verb)(rate(apiserver_request_duration_seconds_bucket{job=\"kubernetes-apiserver\",verb!~\"WATCH|CONNECT\"}[5m])))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "API inflight requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apiserver_current_inflight_requests{job=\"kubernetes-apiserver\"}",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "CoreDNS requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod)(rate(coredns_dns_requests_total{job=\"kubernetes-coredns\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "CoreDNS response codes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod,rcode)(rate(coredns_dns_responses_total{job=\"kubernetes-coredns\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "CoreDNS p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,pod)(rate(coredns_dns_request_duration_seconds_bucket{job=\"kubernetes-coredns\"}[5m])))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Kubelet running pods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kubelet_running_pods{job=\"kubernetes-kubelet\"}",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Scrape duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds{job=~\"kubernetes-apiserver|kubernetes-coredns|kubernetes-node-exporter|kubernetes-kubelet|kubernetes-cadvisor\"}",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    }
  ]
}
