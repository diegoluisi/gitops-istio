{
  "uid": "kubernetes-containers",
  "title": "Kubernetes Containers & Workloads",
  "description": "cAdvisor is scraped from kubelet /metrics/cadvisor once per node. No extra cAdvisor DaemonSet is needed. Missing counters may reflect runtime/cgroup support, not zero usage.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "kubernetes",
    "gitops"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU cores by workload pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(rate(container_cpu_usage_seconds_total{job=\"kubernetes-cadvisor\",container!=\"\",container!=\"POD\",pod!=\"\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory working set",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(container_memory_working_set_bytes{job=\"kubernetes-cadvisor\",container!=\"\",container!=\"POD\",pod!=\"\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU throttled periods fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(rate(container_cpu_cfs_throttled_periods_total{job=\"kubernetes-cadvisor\",container!=\"\",container!=\"POD\"}[5m])) / sum by(namespace,pod)(rate(container_cpu_cfs_periods_total{job=\"kubernetes-cadvisor\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU versus requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(rate(container_cpu_usage_seconds_total{job=\"kubernetes-cadvisor\",container!=\"\",container!=\"POD\"}[5m])) / sum by(namespace,pod)(kube_pod_container_resource_requests{resource=\"cpu\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Container waiting reasons",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_waiting_reason == 1",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Container termination reasons",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_last_terminated_reason == 1",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Ready containers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_ready",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Network received by pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(rate(container_network_receive_bytes_total{job=\"kubernetes-cadvisor\",pod!=\"\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    }
  ]
}
