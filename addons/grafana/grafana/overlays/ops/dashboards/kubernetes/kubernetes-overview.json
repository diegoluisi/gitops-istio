{
  "uid": "kubernetes-overview",
  "title": "Kubernetes Cluster Overview",
  "description": "Resource request totals include declared containers, including pending workloads; they are not scheduler accounting. Metrics-server serves kubectl top/HPA; historical dashboards use cAdvisor and kube-state-metrics.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "kubernetes",
    "gitops"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Node readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_node_status_condition{condition=\"Ready\",status=\"true\"}",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Running pods by namespace",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Pending pods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Pending\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU allocated to requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"}) / sum(kube_node_status_allocatable{resource=\"cpu\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Memory allocated to requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"}) / sum(kube_node_status_allocatable{resource=\"memory\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Deployment unavailable replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_unavailable",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "StatefulSet ready replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_statefulset_status_replicas_ready",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Container restarts / 15m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(increase(kube_pod_container_status_restarts_total[15m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Collector scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"kube-state-metrics|kubernetes-cadvisor|kubernetes-kubelet|kubernetes-node-exporter|kubernetes-apiserver|kubernetes-coredns\"}",
          "legendFormat": "__auto",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Samples discarded by metric hygiene / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(alloy_prometheus_relabel_metrics_processed{component_id=\"prometheus.relabel.metrics_hygiene\"}[5m])) - sum(rate(alloy_prometheus_relabel_metrics_written{component_id=\"prometheus.relabel.metrics_hygiene\"}[5m]))",
          "legendFormat": "Dropped samples",
          "range": true
        }
      ]
    }
  ]
}
