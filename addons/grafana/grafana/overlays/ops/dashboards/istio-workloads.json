{
  "uid": "istio-workloads",
  "title": "Istio Workloads Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "istio",
    "sidecar",
    "mimir",
    "gitops"
  ],
  "description": "Metrics collected from Istio sidecars and gateways by Alloy and stored in Mimir. Reporter series identify each observation point.",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Application namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(istio_requests_total, destination_workload_namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "workload",
        "label": "Workloads",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(istio_requests_total, destination_workload)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, destination_workload_namespace, destination_workload, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval]))",
          "legendFormat": "{{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx percentage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum by (cluster, destination_workload_namespace, destination_workload, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\",response_code=~\"5..\"}[$__rate_interval]))) or (0 * (sum by (cluster, destination_workload_namespace, destination_workload, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval]))))) / (sum by (cluster, destination_workload_namespace, destination_workload, reporter) (rate(istio_requests_total{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval])))",
          "legendFormat": "{{destination_workload}} ({{reporter}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Zero when requests are observed without HTTP 5xx responses; undefined when request rate is zero. Source and destination reporters are kept separate."
    },
    {
      "id": 3,
      "title": "HTTP latency percentiles",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (cluster, le, destination_workload_namespace, destination_workload, reporter) (rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval])))",
          "legendFormat": "{{cluster}} {{destination_workload_namespace}} {{destination_workload}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (cluster, le, destination_workload_namespace, destination_workload, reporter) (rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval])))",
          "legendFormat": "{{cluster}} {{destination_workload_namespace}} {{destination_workload}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (cluster, le, destination_workload_namespace, destination_workload, reporter) (rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval])))",
          "legendFormat": "{{cluster}} {{destination_workload_namespace}} {{destination_workload}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Inbound requests by source workload",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, source_workload_namespace, source_workload) (rate(istio_requests_total{job=\"integrations/istio\",destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Uses raw Istio counters with a rate window adjusted to the selected time range."
    },
    {
      "id": 5,
      "title": "HTTP response codes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, response_code) (rate(istio_requests_total{job=\"integrations/istio\",destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Uses raw Istio counters with a rate window adjusted to the selected time range."
    },
    {
      "id": 6,
      "title": "gRPC error responses",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, grpc_response_status) (rate(istio_requests_total{job=\"integrations/istio\",destination_workload_namespace=~\"$namespace\",destination_workload=~\"$workload\",reporter=\"destination\",request_protocol=\"grpc\",grpc_response_status!=\"0\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "No gRPC traffic means no series; this does not indicate a collection failure."
    },
    {
      "id": 7,
      "title": "Outbound requests by destination",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, destination_service_name) (rate(istio_requests_total{job=\"integrations/istio\",source_workload_namespace=~\"$namespace\",source_workload=~\"$workload\",reporter=\"source\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Uses raw Istio counters with a rate window adjusted to the selected time range."
    },
    {
      "id": 8,
      "title": "Namespace sidecar CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",container=\"istio-proxy\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Namespace sidecar resources include every workload in the namespace."
    },
    {
      "id": 9,
      "title": "Namespace sidecar memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",container=\"istio-proxy\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Namespace sidecar resources include every workload in the namespace."
    }
  ],
  "links": [
    {
      "title": "Istio dashboards",
      "type": "dashboards",
      "tags": [
        "istio"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ]
}
